# Environment variables — copy to `.env.local`

# Groq AI triage (free — get key at groq.com)
GROQ_API_KEY=your_key_here

# OpenAI Text-to-Speech (falls back to browser speech if missing)
OPENAI_API_KEY=sk-your-key-here

# Valsea speech-to-text (optional — falls back to Web Speech API)
NEXT_PUBLIC_VALSEA_API_KEY=your_valsea_key_here

# Vercel KV (required for persistent case storage on Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Hospital configuration
NEXT_PUBLIC_HOSPITAL_NAME=Kandy Teaching Hospital
NEXT_PUBLIC_HOSPITAL_LOCATION=Kandy, Sri Lanka
NEXT_PUBLIC_PRIMARY_COLOR=#1e3a5f
NEXT_PUBLIC_HOSPITAL_LOGO=
